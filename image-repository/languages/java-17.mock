# Mock Java 17 (OpenJDK) Language Package
# Version: 17.0.9
# Size: ~190MB (JRE), ~340MB (JDK)
# Description: Java Development Kit / Runtime Environment (LTS)

LANGUAGE="java"
VERSION="17.0.9"
JAVA_HOME="/usr/lib/jvm/java-17-openjdk"
INSTALL_PATH="${JAVA_HOME}/bin/java"

# Installation commands (mock)
# Ubuntu/Debian: apt-get install -y openjdk-17-jdk
# RedHat/CentOS: yum install -y java-17-openjdk-devel
# Alpine: apk add --no-cache openjdk17

INCLUDES="javac jar jvm"
PACKAGE_MANAGER="maven/gradle"
