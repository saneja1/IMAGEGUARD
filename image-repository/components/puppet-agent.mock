# Mock Puppet Agent Component
# Version: 7.28.0
# Size: ~45MB
# Description: Configuration management agent for Puppet

COMPONENT_NAME="puppet-agent"
VERSION="7.28.0"
INSTALL_PATH="/opt/puppetlabs"
CONFIG_PATH="/etc/puppetlabs/puppet"
SERVICE_NAME="puppet"

# Installation commands (mock)
# apt-get install -y puppet-agent
# yum install -y puppet-agent
# apk add --no-cache puppet-agent

# Configuration files needed:
# - puppet.conf
# - auth.conf
# - SSL certificates

DEPENDENCIES="ruby openssl"
PORTS="8140"
